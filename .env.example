# Microsoft Entra ID — server-side OAuth (keep the client secret server-side)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=https://clarity.ferjani.duckdns.org/auth/microsoft/callback

# Public Entra identifiers used by the browser/MSAL Copilot component
ENTRA_CLIENT_ID=
ENTRA_TENANT_ID=
APP_URL=https://clarity.ferjani.duckdns.org

# Optional Vite aliases for local development
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_APP_URL=https://clarity.ferjani.duckdns.org

# Google OAuth / Gemini — aucune clé API Gemini
# Production: https://clarity.ferjani.duckdns.org
# APP_URL=https://clarity.ferjani.duckdns.org
AI_CONFIG_SECRET=

# AI Gateway multi-comptes : les clés sont stockées chiffrées en PostgreSQL.
# Ne mettez pas les clés Gemini dans le frontend.
# Chaque compte/projet Gemini peut être ajouté depuis Administration > AI Provider Hub.
